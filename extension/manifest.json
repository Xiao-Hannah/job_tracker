{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.2.0",
  "description": "Save job postings from any website to your local Job Tracker",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Job Tracker"
  }
}
