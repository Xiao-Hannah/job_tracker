{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.1.0",
  "description": "Send Workday and LinkedIn job postings to your local Job Tracker",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": [
    "*://*.myworkdayjobs.com/*",
    "*://*.workdayjobs.com/*",
    "*://www.linkedin.com/jobs/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Job Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.workdayjobs.com/*",
        "*://www.linkedin.com/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
