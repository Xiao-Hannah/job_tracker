# Gmail OAuth2 credentials
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add http://localhost:3001/api/gmail/callback as an Authorised redirect URI
# Then copy the Client ID and Secret here and rename this file to .env

GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
